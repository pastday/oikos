# Oikos University 홈페이지 환경변수 템플릿
# 이 파일을 복사해 .env 를 만들어 사용한다.  cp .env.example .env
# 실제 .env 파일은 Git에 커밋하지 않는다. (CLAUDE.md 19항)

# ---------------------------------------------------------------
# 사이트
# ---------------------------------------------------------------
# 개발환경
SITE_URL="http://localhost:3000"
# 운영환경 값: https://oikos.pastday.co.kr

# ---------------------------------------------------------------
# 데이터베이스
# ---------------------------------------------------------------
# 로컬 PostgreSQL 을 직접 설치해 사용한다. (Docker 미사용)
# 포트 주의: 개발 PC의 5432 는 다른 프로젝트가 점유 중이라 5433 으로 구성했다.
# 비밀번호는 각자 로컬에서 생성해 .env 에만 넣는다. 이 파일에는 실제 값을 절대 넣지 않는다.
DATABASE_URL="postgresql://oikos_app:CHANGE_ME@localhost:5433/oikos_dev?schema=public"

# ---------------------------------------------------------------
# 관리자 인증 / Auth.js (7단계부터 사용)
# ---------------------------------------------------------------
# Auth.js v5 는 AUTH_SECRET 을 사용한다. (v4 의 NEXTAUTH_SECRET 이 아니다)
# 세션 JWT 서명·암호화에 쓰이므로 반드시 채워야 하며, 값이 바뀌면 기존 세션은 모두 무효가 된다.
# 생성 방법: openssl rand -base64 32
AUTH_SECRET="CHANGE_ME"

# AUTH_URL 은 보통 필요 없다. Auth.js v5 가 요청에서 자동으로 판단한다.
# 리버스 프록시(nginx) 뒤에서 콜백 URL 이 잘못 잡히는 경우에만 아래 두 값을 사용한다.
# AUTH_URL="https://oikos.pastday.co.kr"
# AUTH_TRUST_HOST="true"

# 최초 SUPER_ADMIN 계정 (npm run admin:create 에서만 사용)
# 비밀번호는 bcrypt 해시로만 DB에 저장되며 평문은 저장하지 않는다.
# 실제 값은 .env 에만 두고 이 파일에는 절대 넣지 않는다.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_NAME="CHANGE_ME"
SEED_ADMIN_PASSWORD="CHANGE_ME"

# ---------------------------------------------------------------
# 업로드 (11단계부터 사용)
# ---------------------------------------------------------------
# 관리자가 올린 이미지·PDF 를 저장할 디렉터리.
#
# 비워 두면 프로젝트 디렉터리의 형제인 ../oikos-data/uploads 를 쓴다.
# (개발/운영 디렉터리가 같아서, 소스 트리 안에 두면 git 작업으로 유실될 수 있다)
#
# ⚠️ systemd 로 띄우는 운영 환경에서는 ProtectHome=read-only 때문에
#    이 경로를 ReadWritePaths 에도 넣어야 저장이 된다. deploy/systemd/oikos.service 참고.
# UPLOAD_DIR="/home/pastday/oikos-data/uploads"
