# Oikos University 홈페이지 환경변수 템플릿
# 이 파일을 복사해 .env 를 만들어 사용한다.  cp .env.example .env
# 실제 .env 파일은 Git에 커밋하지 않는다. (CLAUDE.md 19항)

# ---------------------------------------------------------------
# 사이트
# ---------------------------------------------------------------
# 개발환경
SITE_URL="http://localhost:3000"
# 운영환경 값: https://oikos.pastday.co.kr

# ---------------------------------------------------------------
# 데이터베이스
# ---------------------------------------------------------------
# 로컬 PostgreSQL 을 직접 설치해 사용한다. (Docker 미사용)
# 포트 주의: 개발 PC의 5432 는 다른 프로젝트가 점유 중이라 5433 으로 구성했다.
# 비밀번호는 각자 로컬에서 생성해 .env 에만 넣는다. 이 파일에는 실제 값을 절대 넣지 않는다.
DATABASE_URL="postgresql://oikos_app:CHANGE_ME@localhost:5433/oikos_dev?schema=public"

# ---------------------------------------------------------------
# 관리자 인증 / Auth.js (5단계에서 사용 — 현재 단계에서는 설정 불필요)
# ---------------------------------------------------------------
# 생성 방법: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# 최초 SUPER_ADMIN 시드 계정 (seed 스크립트에서만 사용)
# 비밀번호는 bcrypt 해시로 DB에 저장되며, 평문은 저장하지 않는다.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
