// Oikos University 홈페이지 데이터 모델
//
// 설계 원칙
//  - 이 시스템은 LMS/학사관리 시스템이 아니다. 홍보 홈페이지 + CMS + 상담관리에 필요한 데이터만 관리한다.
//  - 한국어/영어 콘텐츠는 자동 번역하지 않고 동일 Entity의 Ko/En 필드로 각각 관리한다.
//  - 한국어 핵심 필드는 필수, 영어 필드 및 부가 정보는 nullable 로 두어 콘텐츠를 단계적으로 입력할 수 있게 한다.
//  - 원본 자료에 불일치가 있는 값(학점, 과목 수 등)은 임의로 확정하지 않기 위해 nullable 로 둔다.
//
// 자세한 결정 배경은 docs/decisions.md 참고.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// 관리자 권한. 향후 확장 가능하도록 enum 으로 분리한다. (CLAUDE.md 14항)
enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

/// 교수 구분. (CLAUDE.md 7항 - 교수진 관리)
enum FacultyType {
  CHIEF_PROFESSOR // 주임교수
  PROFESSOR // 교수
  VISITING_PROFESSOR // 객원교수
}

/// 과정 구분. 홈페이지 공식 표기는 MBA / DBA 로 통일한다.
/// 원본 문서에 혼재하는 DM / Doctor of Management 는 별도 타입으로 만들지 않는다. (docs/decisions.md 2항)
enum ProgramType {
  MBA
  DBA
}

/// 교과목 구분.
enum CourseCategory {
  MAJOR // 전공
  COMMON // 공통
  CHAPEL // 채플
  OTHER // 기타
}

/// 상담신청·설명회신청 공통 처리 상태.
/// 두 폼의 상태 흐름이 동일하므로 enum 중복을 피하고 하나를 재사용한다.
enum InquiryStatus {
  NEW // 신규
  IN_PROGRESS // 상담중
  COMPLETED // 완료
}

// ---------------------------------------------------------------------------
// 관리자
// ---------------------------------------------------------------------------

/// 관리자 계정.
/// 비밀번호는 반드시 해시(bcrypt)만 저장한다. 평문 저장 금지. (CLAUDE.md 18항)
/// 인증 로직 자체는 5단계에서 구현한다. 여기서는 데이터 구조만 정의한다.
model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("admin_users")
}

// ---------------------------------------------------------------------------
// 홈페이지 콘텐츠
// ---------------------------------------------------------------------------

/// 관리자가 수정 가능한 고정 콘텐츠 영역.
/// 예: pageKey="about" / sectionKey="school"
///     pageKey="admission" / sectionKey="tuition"
///
/// 어떤 pageKey/sectionKey 가 실제로 존재하는지는 `src/lib/cms/page-catalog.ts` 가 정한다.
/// 공개 페이지의 레이아웃이 고정되어 있어 관리자가 임의의 섹션을 새로 만들 수 없기 때문이다.
/// (만들어도 그려 줄 화면이 없다)
///
/// 텍스트 슬롯은 5쌍이며 **모두 nullable** 이다. 섹션마다 쓰는 슬롯이 다르고,
/// 원본 자료에 없는 값을 만들지 않기 위해 비워 둘 수 있어야 한다.
/// 어느 슬롯이 화면 어디에 나오는지는 카탈로그가 섹션별로 설명한다.
///
///   title     섹션 제목
///   subtitle  제목 아래 설명 한 줄 (intro 섹션에서는 상단 eyebrow)
///   body      본문 문단. **빈 줄로 문단을 나눈다**
///   highlight 강조 박스 문구
///   note      하단 보조 안내
///
/// 반복되는 카드·팩트·절차·일정은 이 표에 담을 수 없으므로 `PageSectionItem` 에 둔다.
/// 모두 PostgreSQL text 로 매핑되어 길이 제한이 사실상 없다.
model PageSection {
  id          String  @id @default(cuid())
  pageKey     String
  sectionKey  String
  titleKo     String?
  titleEn     String?
  subtitleKo  String?
  subtitleEn  String?
  bodyKo      String?
  bodyEn      String?
  highlightKo String?
  highlightEn String?
  noteKo      String?
  noteEn      String?
  sortOrder   Int     @default(0)
  isPublished Boolean @default(true)

  /// 섹션 대표 이미지. 이미지 Media 만 연결한다.
  mediaId String?
  media   Media?  @relation("PageSectionImage", fields: [mediaId], references: [id], onDelete: Restrict)

  /// 섹션에 딸린 문서. 지금은 입학안내의 모집요강 PDF 가 유일한 용도다.
  /// 이미지와 따로 두어 한 섹션이 대표 이미지와 첨부 문서를 동시에 가질 수 있게 한다.
  documentMediaId String?
  documentMedia   Media?  @relation("PageSectionDocument", fields: [documentMediaId], references: [id], onDelete: Restrict)

  items PageSectionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pageKey, sectionKey])
  @@map("page_sections")
}

/// 섹션 안에서 **반복되는 항목**.
/// 교육목표 카드, 인가·인증 항목, 입학절차 단계, 학사일정, 팩트 그리드, 등록금 비고가 모두 이 형태다.
///
///   label  카드 제목 · 팩트 라벨 · 절차명 · 기관명
///   value  카드 설명 · 팩트 값 · 기간 · 본문
///
/// 둘 다 nullable 이다. 등록금 비고처럼 value 만 쓰는 항목이 있다.
/// `variant` 는 같은 목록 안에서 표시가 갈리는 경우에만 쓴다. (학사일정의 semester / break)
/// 어떤 값이 허용되는지는 카탈로그가 섹션별로 정하며, 서버에서 그 목록으로 검증한다.
model PageSectionItem {
  id        String      @id @default(cuid())
  sectionId String
  section   PageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  labelKo String?
  labelEn String?
  valueKo String?
  valueEn String?
  variant String?

  /// 항목 이미지. 인가·인증 카드의 기관 로고 같은 용도다. 이미지 Media 만 연결한다.
  mediaId String?
  media   Media?  @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  sortOrder   Int     @default(0)
  isPublished Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sectionId, sortOrder])
  @@map("page_section_items")
}

// ---------------------------------------------------------------------------
// 교수진
// ---------------------------------------------------------------------------

/// 교수진 정보. 연락처 등은 모든 교수에게 존재하지 않으므로 nullable.
model Faculty {
  id              String      @id @default(cuid())
  type            FacultyType
  nameKo          String
  nameEn          String?
  titleKo         String?
  titleEn         String?
  majorKo         String?
  majorEn         String?
  careerKo        String?
  careerEn        String?
  lectureFieldsKo String?
  lectureFieldsEn String?

  /// 교수 사진. 12단계에서 URL 문자열(photoUrl)을 Media 참조로 바꿨다.
  /// 참조로 두면 사용 중인 파일을 DB 가 지우지 못하게 막아 주고,
  /// 사진의 대체 텍스트도 Media 에서 함께 가져올 수 있다.
  photoMediaId String?
  photo        Media?  @relation(fields: [photoMediaId], references: [id], onDelete: Restrict)

  email       String?
  phone       String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// 교수 구분별 목록 조회 + 표시순서 정렬용
  @@index([type, sortOrder])
  @@map("faculties")
}

// ---------------------------------------------------------------------------
// MBA / DBA 과정
// ---------------------------------------------------------------------------

/// MBA / DBA 과정 정보.
/// 학점·학기·과목 수는 원본 문서에 불일치가 있어 임의 확정하지 않기 위해 모두 nullable 이다.
/// 값은 관리자가 CMS에서 직접 입력한다. (하드코딩 금지 - CLAUDE.md 9항)
model Program {
  id                       String      @id @default(cuid())
  type                     ProgramType @unique
  nameKo                   String
  nameEn                   String?
  descriptionKo            String?
  descriptionEn            String?
  durationSemesters        Int?
  totalCredits             Int?
  majorCredits             Int?
  commonCredits            Int?
  chapelCourses            Int?
  classMethodKo            String?
  classMethodEn            String?
  graduationRequirementsKo String?
  graduationRequirementsEn String?
  careerKo                 String?
  careerEn                 String?
  isPublished              Boolean     @default(true)
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  courses Course[]

  @@map("programs")
}

/// 교과목. 학사관리 수준이 아니라 홈페이지 표시용 CMS 수준으로만 관리한다. (CLAUDE.md 8항)
/// 원본 문서상 과목 수·학점 불일치가 있어 실제 데이터는 이번 단계에서 seed 하지 않는다.
model Course {
  id            String         @id @default(cuid())
  programId     String
  /// 원본 문서에 학기차가 명시되지 않은 과목이 있다. (공통과목, 학기차 없이 나열된 전공과목)
  /// 임의로 학기를 배정하지 않기 위해 nullable 로 둔다. 화면에서는 "그 밖의 전공과목" 등으로 묶는다.
  semester      Int?
  credits       Int?
  titleKo       String
  titleEn       String?
  descriptionKo String?
  descriptionEn String?
  category      CourseCategory @default(MAJOR)
  sortOrder     Int            @default(0)
  isPublished   Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  /// 과정별 → 학기별 → 표시순서 조회용. foreign key 인덱스 역할도 겸한다.
  @@index([programId, semester, sortOrder])
  @@map("courses")
}

// ---------------------------------------------------------------------------
// FAQ
// ---------------------------------------------------------------------------

model FAQ {
  id          String   @id @default(cuid())
  questionKo  String
  questionEn  String?
  answerKo    String
  answerEn    String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
  @@map("faqs")
}

// ---------------------------------------------------------------------------
// 입학상담 / 설명회 신청
// ---------------------------------------------------------------------------

/// 방문자 입학상담 신청. 개인정보를 포함하므로 취급에 주의한다.
model Consultation {
  id                String        @id @default(cuid())
  name              String
  phone             String
  email             String
  interestedProgram ProgramType?
  message           String?
  status            InquiryStatus @default(NEW)
  privacyAgreed     Boolean       @default(false)
  /// 신청서를 제출한 사이트 언어. "ko" 또는 "en"
  locale            String        @default("ko")
  adminMemo         String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  /// 관리자 상담목록의 상태 필터 + 최신순 정렬용 (CLAUDE.md 12항)
  @@index([status, createdAt])
  @@map("consultations")
}

/// 설명회 신청. 초기에는 복잡한 예약 시스템을 만들지 않으므로
/// preferredSession 은 자유 입력 문자열로 둔다. (CLAUDE.md 13항)
model SeminarApplication {
  id               String        @id @default(cuid())
  name             String
  phone            String
  email            String
  preferredSession String?
  attendeeCount    Int           @default(1)
  memo             String?
  privacyAgreed    Boolean       @default(false)
  locale           String        @default("ko")
  status           InquiryStatus @default(NEW)
  adminMemo        String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status, createdAt])
  @@map("seminar_applications")
}

// ---------------------------------------------------------------------------
// 파일 / 사이트 설정
// ---------------------------------------------------------------------------

/// 업로드 파일 메타정보. 실제 업로드 기능은 8단계에서 구현한다.
/// path 는 스토리지 종류에 의존하지 않는 상대 경로로 저장해
/// 향후 로컬 → 클라우드 Object Storage 전환이 쉽도록 한다. (CLAUDE.md 15항)
model Media {
  id           String  @id @default(cuid())
  originalName String
  storedName   String  @unique
  mimeType     String
  size         Int
  /// 파일시스템 경로가 아니라 **공개 URL** 이다. (예: /media/<uuid>.jpg)
  path         String
  altKo        String?
  altEn        String?

  /// 이 파일을 쓰고 있는 곳. 전부 `onDelete: Restrict` 라
  /// **사용 중인 파일은 DB 가 삭제를 거부한다.**
  /// 앱에서도 `findMediaUsage()` 로 미리 막지만, 그 검사를 우회해도 참조가 끊기지 않는다.
  pageSectionImages    PageSection[]     @relation("PageSectionImage")
  pageSectionDocuments PageSection[]     @relation("PageSectionDocument")
  pageSectionItems     PageSectionItem[]
  facultyPhotos        Faculty[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("media")
}

/// 사이트 전역 설정. (대표 전화·이메일, 본교/FICB URL, 모집학기 등)
/// 언어 무관 값은 value, 한/영문 구분이 필요한 값은 valueKo/valueEn 을 사용한다.
model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String?
  valueKo   String?
  valueEn   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}
