// Oikos University 홈페이지 데이터 모델
//
// 설계 원칙
//  - 이 시스템은 LMS/학사관리 시스템이 아니다. 홍보 홈페이지 + CMS + 상담관리에 필요한 데이터만 관리한다.
//  - 한국어/영어 콘텐츠는 자동 번역하지 않고 동일 Entity의 Ko/En 필드로 각각 관리한다.
//  - 한국어 핵심 필드는 필수, 영어 필드 및 부가 정보는 nullable 로 두어 콘텐츠를 단계적으로 입력할 수 있게 한다.
//  - 원본 자료에 불일치가 있는 값(학점, 과목 수 등)은 임의로 확정하지 않기 위해 nullable 로 둔다.
//
// 자세한 결정 배경은 docs/decisions.md 참고.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// 관리자 권한. 향후 확장 가능하도록 enum 으로 분리한다. (CLAUDE.md 14항)
enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

/// 교수 구분. (CLAUDE.md 7항 - 교수진 관리)
enum FacultyType {
  CHIEF_PROFESSOR // 주임교수
  PROFESSOR // 교수
  VISITING_PROFESSOR // 객원교수
}

/// 과정 구분. 홈페이지 공식 표기는 MBA / DBA 로 통일한다.
/// 원본 문서에 혼재하는 DM / Doctor of Management 는 별도 타입으로 만들지 않는다. (docs/decisions.md 2항)
enum ProgramType {
  MBA
  DBA
}

/// 교과목 구분.
enum CourseCategory {
  MAJOR // 전공
  COMMON // 공통
  CHAPEL // 채플
  OTHER // 기타
}

/// 학교소식 카테고리.
///
/// 처음부터 복잡한 분류 체계를 만들지 않는다. 다섯 값이면 충분하다. (학교소식 지시 8항)
/// 한/영 표시 문구는 코드(`src/lib/cms/news.ts`, `src/components/admin/cms-ui.tsx`)에 둔다.
/// 교수 관련 외부 언론보도(`FacultyArticle`)와는 전혀 다른 기능이다. (지시 16항)
enum NewsCategory {
  NOTICE // 공지
  EVENT // 행사
  ACADEMIC // 학사
  MEDIA // 미디어
  OTHER // 기타
}

/// 학교소식에 딸린 관련 링크의 종류.
///  - ARTICLE: 언론기사·외부 블로그 등 일반 외부 링크. 상세에서 "관련 기사"로 나온다.
///  - VIDEO:   YouTube 영상. 상세에서 embed iframe 으로 나온다. (video ID 는 URL 에서 추출)
enum NewsLinkType {
  ARTICLE
  VIDEO
}

/// 자료실 카테고리. 처음에는 네 값만 쓴다. (자료실 지시 3항)
/// 한/영 표시 문구는 코드(`src/lib/cms/resources.ts`, `src/components/admin/cms-ui.tsx`)에 둔다.
///  - ADMISSION: 입학 관련 서식. **입학안내 페이지 하단에도 자동 노출된다.** (지시 16항)
///  - GUIDE:     모집요강
///  - ACADEMIC:  학사 자료
///  - OTHER:     기타 자료
enum ResourceCategory {
  ADMISSION
  GUIDE
  ACADEMIC
  OTHER
}

/// 상담신청·설명회신청 공통 처리 상태.
/// 두 폼의 상태 흐름이 동일하므로 enum 중복을 피하고 하나를 재사용한다.
enum InquiryStatus {
  NEW // 신규
  IN_PROGRESS // 상담중
  COMPLETED // 완료
}

// ---------------------------------------------------------------------------
// 관리자
// ---------------------------------------------------------------------------

/// 관리자 계정.
/// 비밀번호는 반드시 해시(bcrypt)만 저장한다. 평문 저장 금지. (CLAUDE.md 18항)
/// 인증 로직 자체는 5단계에서 구현한다. 여기서는 데이터 구조만 정의한다.
model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("admin_users")
}

// ---------------------------------------------------------------------------
// 홈페이지 콘텐츠
// ---------------------------------------------------------------------------

/// 관리자가 수정 가능한 고정 콘텐츠 영역.
/// 예: pageKey="about" / sectionKey="school"
///     pageKey="admission" / sectionKey="tuition"
///
/// 어떤 pageKey/sectionKey 가 실제로 존재하는지는 `src/lib/cms/page-catalog.ts` 가 정한다.
/// 공개 페이지의 레이아웃이 고정되어 있어 관리자가 임의의 섹션을 새로 만들 수 없기 때문이다.
/// (만들어도 그려 줄 화면이 없다)
///
/// 텍스트 슬롯은 5쌍이며 **모두 nullable** 이다. 섹션마다 쓰는 슬롯이 다르고,
/// 원본 자료에 없는 값을 만들지 않기 위해 비워 둘 수 있어야 한다.
/// 어느 슬롯이 화면 어디에 나오는지는 카탈로그가 섹션별로 설명한다.
///
///   title     섹션 제목
///   subtitle  제목 아래 설명 한 줄 (intro 섹션에서는 상단 eyebrow)
///   body      본문 문단. **빈 줄로 문단을 나눈다**
///   highlight 강조 박스 문구
///   note      하단 보조 안내
///
/// 반복되는 카드·팩트·절차·일정은 이 표에 담을 수 없으므로 `PageSectionItem` 에 둔다.
/// 모두 PostgreSQL text 로 매핑되어 길이 제한이 사실상 없다.
model PageSection {
  id          String  @id @default(cuid())
  pageKey     String
  sectionKey  String
  titleKo     String?
  titleEn     String?
  subtitleKo  String?
  subtitleEn  String?
  bodyKo      String?
  bodyEn      String?
  highlightKo String?
  highlightEn String?
  noteKo      String?
  noteEn      String?
  sortOrder   Int     @default(0)
  isPublished Boolean @default(true)

  /// 섹션 대표 이미지. 이미지 Media 만 연결한다.
  mediaId String?
  media   Media?  @relation("PageSectionImage", fields: [mediaId], references: [id], onDelete: Restrict)

  /// 섹션에 딸린 문서. 지금은 입학안내의 모집요강 PDF 가 유일한 용도다.
  /// 이미지와 따로 두어 한 섹션이 대표 이미지와 첨부 문서를 동시에 가질 수 있게 한다.
  documentMediaId String?
  documentMedia   Media?  @relation("PageSectionDocument", fields: [documentMediaId], references: [id], onDelete: Restrict)

  items PageSectionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pageKey, sectionKey])
  @@map("page_sections")
}

/// 섹션 안에서 **반복되는 항목**.
/// 교육목표 카드, 인가·인증 항목, 입학절차 단계, 학사일정, 팩트 그리드, 등록금 비고가 모두 이 형태다.
///
///   label  카드 제목 · 팩트 라벨 · 절차명 · 기관명
///   value  카드 설명 · 팩트 값 · 기간 · 본문
///
/// 둘 다 nullable 이다. 등록금 비고처럼 value 만 쓰는 항목이 있다.
/// `variant` 는 같은 목록 안에서 표시가 갈리는 경우에만 쓴다. (학사일정의 semester / break)
/// 어떤 값이 허용되는지는 카탈로그가 섹션별로 정하며, 서버에서 그 목록으로 검증한다.
model PageSectionItem {
  id        String      @id @default(cuid())
  sectionId String
  section   PageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  labelKo String?
  labelEn String?
  valueKo String?
  valueEn String?
  variant String?

  /// 항목 이미지. 인가·인증 카드의 기관 로고 같은 용도다. 이미지 Media 만 연결한다.
  mediaId String?
  media   Media?  @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  sortOrder   Int     @default(0)
  isPublished Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sectionId, sortOrder])
  @@map("page_section_items")
}

// ---------------------------------------------------------------------------
// 교수진
// ---------------------------------------------------------------------------

/// 교수진 정보. 연락처 등은 모든 교수에게 존재하지 않으므로 nullable.
model Faculty {
  id      String      @id @default(cuid())
  type    FacultyType
  nameKo  String
  nameEn  String?
  titleKo String?
  titleEn String?
  majorKo String?
  majorEn String?

  /// 상세 프로필. 전부 nullable 이다. 자료가 없는 교수도 등록할 수 있어야 한다.
  /// `bio` 는 문단 글, 나머지 셋은 **한 줄에 한 항목**으로 입력해 화면에서 목록으로 그린다.
  ///
  /// 경력 한 줄마다 행을 만드는 별도 테이블을 두지 않는다. 홈페이지는 경력을
  /// 정렬·검색·집계하지 않고 그대로 나열하기만 하므로 관리자가 textarea 에
  /// 붙여넣는 편이 빠르다. 나중에 구조화가 필요해지면 이 텍스트를 옮기면 된다.
  bioKo           String?
  bioEn           String?
  educationKo     String?
  educationEn     String?
  careerKo        String?
  careerEn        String?
  /// 전문분야 겸 강의 분야. 두 값이 사실상 같아 필드를 나누지 않는다.
  lectureFieldsKo String?
  lectureFieldsEn String?

  /// 교수 사진. 12단계에서 URL 문자열(photoUrl)을 Media 참조로 바꿨다.
  /// 참조로 두면 사용 중인 파일을 DB 가 지우지 못하게 막아 주고,
  /// 사진의 대체 텍스트도 Media 에서 함께 가져올 수 있다.
  photoMediaId String?
  photo        Media?  @relation(fields: [photoMediaId], references: [id], onDelete: Restrict)

  email       String?
  phone       String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// 주요 저서 · 언론 보도. 교수가 지워지면 함께 지운다. (아래 두 모델 주석 참고)
  books    FacultyBook[]
  articles FacultyArticle[]

  /// 교수 구분별 목록 조회 + 표시순서 정렬용
  @@index([type, sortOrder])
  @@map("faculties")
}

/// 교수의 **주요 저서** 한 권. (15단계)
///
/// 학력·경력과 달리 textarea 한 칸에 줄 단위로 적지 않고 행으로 나눈다.
/// 한 권마다 출판사·발행일·ISBN·외부 링크·표지가 따로 붙고 화면도 카드로 그리기 때문이다.
/// (경력을 왜 텍스트로 두었는지는 `Faculty.careerKo` 주석 참고 — 기준이 다르다)
///
/// **한국어 제목만 필수다.** 나머지는 전부 nullable 이다. 원본에 없는 값을
/// 지어내지 않는 것이 이 프로젝트의 원칙이라 (CLAUDE.md 23항) 확인되지 않은 칸은
/// 비워 둔 채로 저장할 수 있어야 한다. 영문 제목이 비면 영문 페이지에서
/// 한국어 원표기를 그대로 쓴다. (`pickLocale`)
///
/// 표지 이미지는 **사용권이 확인된 파일만** Media 로 올려 연결한다.
/// 서점 CDN 이미지를 내려받거나 hotlink 하지 않는다. 없으면 화면이 글자 표지를 그린다.
model FacultyBook {
  id        String  @id @default(cuid())
  facultyId String
  /// 교수를 지우면 저서도 함께 사라진다. 교수 없이 남은 저서는 화면에 나올 곳이 없다.
  /// `Course` → `Program` 과 같은 정책이다.
  faculty   Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  titleKo     String
  titleEn     String?
  subtitleKo  String?
  subtitleEn  String?
  /// 공저·역서가 있을 수 있어 자유 입력이다. 교수 본인 이름만 넣는 칸이 아니다.
  authorKo    String?
  authorEn    String?
  publisherKo String?
  publisherEn String?

  /// 발행일. **날짜만** 저장한다. (`@db.Date`)
  /// 시각 개념이 없는 값이라 timestamp 로 두면 표시할 때 시간대 때문에 하루가 밀린다.
  publishedAt DateTime? @db.Date

  /// 원본에 표기된 것만 넣는다. 형식은 서버에서 숫자·하이픈으로만 제한한다.
  isbn String?

  /// 홈페이지용 짧은 소개. **서점 상품설명을 그대로 옮기지 않는다.** (CLAUDE.md 22항)
  descriptionKo String?
  descriptionEn String?

  /// 서점·출판사 상품 페이지. http/https 만 허용한다. 없으면 링크를 그리지 않는다.
  externalUrl String?

  coverMediaId String?
  cover        Media?  @relation("FacultyBookCover", fields: [coverMediaId], references: [id], onDelete: Restrict)

  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// 교수별 → 표시순서 조회용. foreign key 인덱스 역할도 겸한다.
  @@index([facultyId, sortOrder])
  @@map("faculty_books")
}

/// 교수 관련 **언론 · 미디어 보도** 한 건. (15단계)
///
/// 홈페이지에는 **제목 · 게시처 · 게시일 · 우리가 쓴 짧은 소개 · 원문 링크**만 둔다.
/// 기사 본문을 옮겨 저장하지 않는다. 저작권 때문이다. (CLAUDE.md 22항)
/// 같은 이유로 기사에 실린 사진도 내려받지 않는다. `imageMediaId` 는 학교가 가지고 있거나
/// 사용권이 확인된 이미지가 있을 때만 연결하는 칸이며, 비어 있는 것이 기본 상태다.
model FacultyArticle {
  id        String  @id @default(cuid())
  facultyId String
  faculty   Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  titleKo String
  titleEn String?

  /// 우리가 직접 쓴 1~2문장 소개. 기사 원문 문장을 옮겨 오지 않는다.
  summaryKo String?
  summaryEn String?

  /// 게시처(매체명). 확인된 공식 영문명이 있을 때만 En 을 채운다.
  publisherKo String?
  publisherEn String?

  /// 게시일. 저서와 같은 이유로 날짜만 저장한다.
  publishedAt DateTime? @db.Date

  externalUrl String?

  imageMediaId String?
  image        Media?  @relation("FacultyArticleImage", fields: [imageMediaId], references: [id], onDelete: Restrict)

  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([facultyId, sortOrder])
  @@map("faculty_articles")
}

// ---------------------------------------------------------------------------
// MBA / DBA 과정
// ---------------------------------------------------------------------------

/// MBA / DBA 과정 정보.
/// 학점·학기·과목 수는 원본 문서에 불일치가 있어 임의 확정하지 않기 위해 모두 nullable 이다.
/// 값은 관리자가 CMS에서 직접 입력한다. (하드코딩 금지 - CLAUDE.md 9항)
model Program {
  id                       String      @id @default(cuid())
  type                     ProgramType @unique
  nameKo                   String
  nameEn                   String?
  descriptionKo            String?
  descriptionEn            String?
  durationSemesters        Int?
  totalCredits             Int?
  majorCredits             Int?
  commonCredits            Int?
  chapelCourses            Int?
  classMethodKo            String?
  classMethodEn            String?
  graduationRequirementsKo String?
  graduationRequirementsEn String?
  careerKo                 String?
  careerEn                 String?
  isPublished              Boolean     @default(true)
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  courses Course[]

  @@map("programs")
}

/// 교과목. 학사관리 수준이 아니라 홈페이지 표시용 CMS 수준으로만 관리한다. (CLAUDE.md 8항)
/// 원본 문서상 과목 수·학점 불일치가 있어 실제 데이터는 이번 단계에서 seed 하지 않는다.
model Course {
  id            String         @id @default(cuid())
  programId     String
  /// 원본 문서에 학기차가 명시되지 않은 과목이 있다. (공통과목, 학기차 없이 나열된 전공과목)
  /// 임의로 학기를 배정하지 않기 위해 nullable 로 둔다. 화면에서는 "그 밖의 전공과목" 등으로 묶는다.
  semester      Int?
  credits       Int?
  titleKo       String
  titleEn       String?
  descriptionKo String?
  descriptionEn String?
  category      CourseCategory @default(MAJOR)
  sortOrder     Int            @default(0)
  isPublished   Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  /// 과정별 → 학기별 → 표시순서 조회용. foreign key 인덱스 역할도 겸한다.
  @@index([programId, semester, sortOrder])
  @@map("courses")
}

// ---------------------------------------------------------------------------
// FAQ
// ---------------------------------------------------------------------------

model FAQ {
  id          String   @id @default(cuid())
  questionKo  String
  questionEn  String?
  answerKo    String
  answerEn    String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
  @@map("faqs")
}

// ---------------------------------------------------------------------------
// 학교소식
// ---------------------------------------------------------------------------

/// 학교 자체 소식 한 건. (행사 · 공지 · 홍보)
///
/// **교수 관련 외부 언론보도(`FacultyArticle`)와 별개의 기능이다.** (지시 16항)
///  - 교수 개인의 외부 기사 → `FacultyArticle` → 교수진 상세의 "언론 · 미디어"
///  - 학교 단위의 행사 · 공지 → `NewsPost` → `/news` 목록·상세
/// 기존 `FacultyArticle` 데이터를 이쪽으로 옮기지 않는다.
///
/// **한국어 제목·본문만 필수다.** 영문 필드가 비면 영문 페이지에서 한국어를 그대로
/// 보여 준다. (`pickLocale` — 없는 번역을 지어내지 않는다는 기존 정책)
///
/// 본문은 rich text 가 아니라 **여러 문단의 평문**이다. 빈 줄로 문단을 나눈다.
/// (`PageSection.bodyKo` 와 같은 방식) HTML 직접 입력은 받지 않는다.
model NewsPost {
  id String @id @default(cuid())

  /// 상세 URL 세그먼트. 사람이 읽을 수 있는 값이며 유일하다.
  /// 관리자가 비워 두면 저장 시 한국어 제목에서 자동 생성하고, 겹치면 뒤에 -2, -3 을 붙인다.
  slug String @unique

  titleKo   String
  titleEn   String?
  summaryKo String?
  summaryEn String?
  /// 본문. 빈 줄로 문단을 나눈다. 한국어는 필수.
  contentKo String
  contentEn String?

  category NewsCategory @default(NOTICE)

  /// 게시일. 목록 정렬·표시에 쓴다. **날짜만** 저장한다. (`FacultyArticle.publishedAt` 과 같은 이유)
  /// 미래 날짜 예약 게시는 만들지 않는다. (지시 9항)
  publishedAt DateTime @db.Date

  /// 공개 여부. 비공개면 관리자에서만 보이고 `/news` 목록·상세에서 사라진다.
  isPublished Boolean @default(true)

  /// 대표 이미지. **기존 `Media` 를 재사용한다.** 없으면 화면이 이미지 영역을 생략한다.
  /// `onDelete: Restrict` 라 사용 중인 파일은 DB 가 삭제를 거부한다. (다른 콘텐츠와 같은 정책)
  coverMediaId String?
  cover        Media?  @relation("NewsPostCover", fields: [coverMediaId], references: [id], onDelete: Restrict)

  /// 첨부파일. `Media` 를 그대로 쓰되, 한 소식이 여러 개를 순서대로 가질 수 있어
  /// 조인 테이블을 둔다. (`PageSection` 은 문서가 하나뿐이라 단일 FK 였다)
  attachments NewsAttachment[]

  /// 관련 기사·외부 링크·YouTube 영상. 관리자가 여러 개 추가·삭제·정렬할 수 있어
  /// 관계형 모델로 둔다. (문자열/JSON 배열보다 정렬·검증이 명확하다)
  links NewsLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// 공개 목록의 최신순 정렬용
  @@index([isPublished, publishedAt])
  @@map("news_posts")
}

/// 학교소식 ↔ 첨부파일 연결. (지시 4·14항)
///
/// **별도 파일 테이블을 새로 만들지 않는다.** 기존 `Media` 를 재사용하고
/// 소속·순서만 이 표가 담는다. 소식을 지우면 이 연결 행만 함께 사라지고
/// (`onDelete: Cascade`) `Media` 파일 자체는 남는다. (지시 15항 — 물리 삭제 금지)
model NewsAttachment {
  id     String   @id @default(cuid())
  postId String
  post   NewsPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  mediaId String
  media   Media  @relation("NewsAttachmentMedia", fields: [mediaId], references: [id], onDelete: Restrict)

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  /// 같은 파일을 한 소식에 두 번 붙이지 않는다.
  @@unique([postId, mediaId])
  @@index([postId, sortOrder])
  @@map("news_attachments")
}

/// 학교소식의 관련 기사 · 외부 링크 · 동영상 한 건. (학교소식 UX 정비 3항)
///
/// `FacultyArticle`(교수 개인 언론보도)과는 무관한 별도 테이블이다.
/// 여기 링크는 학교소식 게시물에 붙는 참고 링크이며, 화면도 `/news/[slug]` 상세에서만 나온다.
///
/// **한국어 제목만 필수.** 영문이 비면 영문 페이지에서 한국어를 그대로 쓴다. (`pickLocale`)
/// `url` 은 저장 시 http/https 만 통과하며, VIDEO 는 추가로 YouTube URL 만 허용한다.
/// video ID 추출·embed URL 생성은 화면 조회 단계에서 한다. (`lib/cms/news.ts`)
model NewsLink {
  id     String       @id @default(cuid())
  postId String
  post   NewsPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  type   NewsLinkType

  titleKo String
  titleEn String?
  url     String

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([postId, sortOrder])
  @@map("news_links")
}

// ---------------------------------------------------------------------------
// 자료실
// ---------------------------------------------------------------------------

/// 자료실 게시물 한 건. **다운로드 파일 중심**의 콘텐츠다. (자료실 지시 27항)
///
/// 학교소식(`NewsPost`)과는 **완전히 별도**다. 뉴스/행사/언론/영상 → `NewsPost`,
/// 다운로드 파일/서식/문서 → `ResourcePost`. 데이터를 서로 옮기지 않는다.
///
/// **한국어 제목만 필수다.** 요약·본문·영문은 모두 선택이다. 영문이 비면 영문
/// 페이지에서 한국어를 그대로 보여 준다. (`pickLocale` — 학교소식과 같은 fallback 정책)
///
/// 대표 이미지는 두지 않는다. 자료실은 파일 목록이 본체다. (지시 5항)
model ResourcePost {
  id String @id @default(cuid())

  /// 상세 URL 세그먼트. 학교소식과 같은 규칙(`slugifyNews`)으로 정규화한다.
  slug String @unique

  category ResourceCategory @default(OTHER)

  titleKo   String
  titleEn   String?
  summaryKo String?
  summaryEn String?
  /// 본문/설명. 여러 문단의 평문이다. HTML 로 해석하지 않는다. (지시 4항)
  contentKo String?
  contentEn String?

  /// 게시일. **날짜만** 저장한다. (`NewsPost.publishedAt` 과 같은 이유)
  publishedAt DateTime @db.Date

  /// 공개 여부. 비공개면 관리자에서만 보이고 자료실·입학안내에서 사라진다. (지시 14항)
  isPublished Boolean @default(true)

  /// 첨부파일. **기존 `Media` 를 재사용**하고 소속·순서만 이 조인 테이블이 담는다.
  attachments ResourceAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// 공개 목록의 최신순 정렬용
  @@index([isPublished, publishedAt])
  /// 입학안내 하단의 "입학 관련 서류" 조회용 (category + 공개 + 최신순)
  @@index([category, isPublished, publishedAt])
  @@map("resource_posts")
}

/// 자료실 게시물 ↔ 첨부파일 연결. (자료실 지시 5·21·22항)
///
/// **별도 파일 테이블을 만들지 않는다.** 기존 `Media` 를 재사용한다.
/// 게시물을 지우면 이 연결 행만 함께 사라지고 (`onDelete: Cascade`),
/// `Media` 파일 자체는 남는다. (다른 콘텐츠와 공유될 수 있다 — 지시 22항)
model ResourceAttachment {
  id     String       @id @default(cuid())
  postId String
  post   ResourcePost @relation(fields: [postId], references: [id], onDelete: Cascade)

  mediaId String
  media   Media  @relation("ResourceAttachmentMedia", fields: [mediaId], references: [id], onDelete: Restrict)

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  /// 같은 파일을 한 게시물에 두 번 붙이지 않는다.
  @@unique([postId, mediaId])
  @@index([postId, sortOrder])
  @@map("resource_attachments")
}

// ---------------------------------------------------------------------------
// 입학상담 / 설명회 신청
// ---------------------------------------------------------------------------

/// 방문자 입학상담 신청. 개인정보를 포함하므로 취급에 주의한다.
model Consultation {
  id                String        @id @default(cuid())
  name              String
  phone             String
  email             String
  interestedProgram ProgramType?
  message           String?
  status            InquiryStatus @default(NEW)
  privacyAgreed     Boolean       @default(false)
  /// 신청서를 제출한 사이트 언어. "ko" 또는 "en"
  locale            String        @default("ko")
  adminMemo         String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  /// 관리자 상담목록의 상태 필터 + 최신순 정렬용 (CLAUDE.md 12항)
  @@index([status, createdAt])
  @@map("consultations")
}

/// 설명회 신청. 초기에는 복잡한 예약 시스템을 만들지 않으므로
/// preferredSession 은 자유 입력 문자열로 둔다. (CLAUDE.md 13항)
model SeminarApplication {
  id               String        @id @default(cuid())
  name             String
  phone            String
  email            String
  preferredSession String?
  attendeeCount    Int           @default(1)
  memo             String?
  privacyAgreed    Boolean       @default(false)
  locale           String        @default("ko")
  status           InquiryStatus @default(NEW)
  adminMemo        String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status, createdAt])
  @@map("seminar_applications")
}

// ---------------------------------------------------------------------------
// 파일 / 사이트 설정
// ---------------------------------------------------------------------------

/// 업로드 파일 메타정보. 실제 업로드 기능은 8단계에서 구현한다.
/// path 는 스토리지 종류에 의존하지 않는 상대 경로로 저장해
/// 향후 로컬 → 클라우드 Object Storage 전환이 쉽도록 한다. (CLAUDE.md 15항)
model Media {
  id           String  @id @default(cuid())
  originalName String
  storedName   String  @unique
  mimeType     String
  size         Int
  /// 파일시스템 경로가 아니라 **공개 URL** 이다. (예: /media/<uuid>.jpg)
  path         String
  altKo        String?
  altEn        String?

  /// 이 파일을 쓰고 있는 곳. 전부 `onDelete: Restrict` 라
  /// **사용 중인 파일은 DB 가 삭제를 거부한다.**
  /// 앱에서도 `findMediaUsage()` 로 미리 막지만, 그 검사를 우회해도 참조가 끊기지 않는다.
  pageSectionImages    PageSection[]        @relation("PageSectionImage")
  pageSectionDocuments PageSection[]        @relation("PageSectionDocument")
  pageSectionItems     PageSectionItem[]
  facultyPhotos        Faculty[]
  facultyBookCovers    FacultyBook[]        @relation("FacultyBookCover")
  facultyArticleImages FacultyArticle[]     @relation("FacultyArticleImage")
  newsPostCovers       NewsPost[]           @relation("NewsPostCover")
  newsAttachments      NewsAttachment[]     @relation("NewsAttachmentMedia")
  resourceAttachments  ResourceAttachment[] @relation("ResourceAttachmentMedia")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("media")
}

/// 사이트 전역 설정. (대표 전화·이메일, 본교/FICB URL, 모집학기 등)
/// 언어 무관 값은 value, 한/영문 구분이 필요한 값은 valueKo/valueEn 을 사용한다.
model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String?
  valueKo   String?
  valueEn   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

// ---------------------------------------------------------------------------
// 온라인 입학신청 (18단계)
//
// 범위를 의도적으로 좁게 잡았다. 학사관리 시스템이 아니라
// **종이 입학원서를 온라인 폼으로 옮긴 것 + 관리자 확인 화면**이다.
//
// 그래서 다음을 만들지 않는다.
//   - 지원자 계정 / 로그인 / 임시저장(DRAFT)  → 한 번에 작성하고 한 번에 저장한다
//   - 추천인 전용 URL / 이메일 발송           → 추천서는 지원자가 완성본을 업로드한다
//   - 확인서 version 관리 / audit 테이블      → 확인서 본문은 코드 상수, 기록은 adminMemo 하나
//
// 필드는 `docs/source/입학서류/1.Application 한글-2-2.hwp` 의 칸을 그대로 옮긴 것이다.
// 원본에 없는 칸(전공, 경력 상세설명 등)은 만들지 않는다. (CLAUDE.md 23항)
// ---------------------------------------------------------------------------

/// 입학신청 처리 상태. 상담(`InquiryStatus`)과 흐름이 달라 따로 둔다.
/// 화면 표기는 신규 / 확인중 / 완료.
enum AdmissionStatus {
  NEW
  IN_REVIEW
  COMPLETED
}

/// 입학 학기. 원본 입학원서에 Spring / Fall 두 칸만 있다.
enum AdmissionTerm {
  SPRING
  FALL
}

/// 성별. 원본 입학원서의 "남 / 여" 두 칸.
enum AdmissionGender {
  MALE
  FEMALE
}

/// 혼인상태. 원본 입학원서의 "미혼 / 기혼" 두 칸. 선택 항목이다.
enum AdmissionMaritalStatus {
  SINGLE
  MARRIED
}

/// 첨부파일 종류.
///
/// 서명 3종(`SIGNATURE_*`)도 여기 들어간다. 확인서 서명은 PNG 파일이고
/// 저장·다운로드 규칙이 다른 첨부파일과 완전히 같기 때문에 표를 나누지 않는다.
/// 어떤 확인서의 서명인지는 type 이 구분한다.
///
/// `GENERATED_PDF` 는 자리만 잡아 둔다. 이번 단계의 PDF 는 서버가 파일을 만들지 않고
/// 관리자가 인쇄용 화면에서 브라우저로 저장한다. (지시 23항)
enum AdmissionFileType {
  GRADUATION_CERTIFICATE
  TRANSCRIPT
  PASSPORT
  PHOTO
  INSURANCE
  PHONE_BILL
  ELECTRIC_BILL
  RENT_BILL
  RECOMMENDATION
  SIGNATURE_INSTITUTIONAL_PURPOSE
  SIGNATURE_CODE_OF_CONDUCT
  SIGNATURE_STATEMENT_OF_FAITH
  GENERATED_PDF
}

/// 온라인 입학신청서 한 건.
///
/// **임시저장이 없으므로 이 행은 "제출된 신청서"만 뜻한다.** 작성 중 상태가 없어
/// 모든 필수 칸이 채워진 뒤에야 만들어진다. 그래서 필수 필드를 nullable 로 두지 않는다.
///
/// ⚠️ `residentNumberEncrypted` 는 **암호문만** 담는다. 평문 컬럼은 존재하지 않는다.
///    읽고 쓰는 곳은 `src/lib/admission/crypto.ts` 하나뿐이다.
model AdmissionApplication {
  id String @id @default(cuid())

  /// 사람이 보는 접수번호. 예: 2026-000001
  /// DB id 와 분리한다. id 는 URL·FK 용이고 이 값은 지원자·관리자가 주고받는 번호다.
  applicationNo String          @unique
  status        AdmissionStatus @default(NEW)

  /// 지원 과정. 온라인 신청은 MBA / DBA 만 받는다. (기존 enum 재사용)
  program       ProgramType
  admissionYear Int
  admissionTerm AdmissionTerm

  nameKo String
  nameEn String

  /// AES-256-GCM 암호문. 형식은 `v1:<iv>:<tag>:<ciphertext>` (전부 base64)
  /// 관리자 목록에서는 조회조차 하지 않고, 상세에서는 마스킹해서만 보여준다.
  residentNumberEncrypted String

  birthDate   DateTime        @db.Date
  gender      AdmissionGender
  nationality String
  birthplace  String

  addressKo String
  addressEn String
  phone     String
  email     String

  usCitizen              Boolean
  /// 원본 입학원서에는 있으나 국내 지원자에게 해당하지 않을 수 있어 선택 항목이다.
  driversLicenseNumber   String?
  driversLicenseIssuedAt String?

  emergencyName         String
  emergencyRelationship String
  emergencyPhone        String
  emergencyAddress      String

  maritalStatus AdmissionMaritalStatus?

  /// 자기소개서 3문항. 질문 문구는 원본 서식에 없어 우리가 정한 것이며
  /// `src/content/admission` 에 코드 상수로 둔다. CMS 로 관리하지 않는다. (지시 12항)
  personalIntroduction String
  motivation           String
  studyPlan            String

  /// 확인서 3종. 각각 별도 동의 + 별도 서명이다. (지시 13항)
  /// 서명 이미지 자체는 `AdmissionFile` 의 `SIGNATURE_*` 행에 있다.
  /// 여기 두 값을 함께 저장하는 이유는 **서명 당시 적어 낸 이름과 시각**이 문서의 일부이기 때문이다.
  institutionalPurposeAgreed     Boolean   @default(false)
  institutionalPurposeSignedName String?
  institutionalPurposeSignedAt   DateTime?

  codeOfConductAgreed     Boolean   @default(false)
  codeOfConductSignedName String?
  codeOfConductSignedAt   DateTime?

  statementOfFaithAgreed     Boolean   @default(false)
  statementOfFaithSignedName String?
  statementOfFaithSignedAt   DateTime?

  /// 개인정보 수집 동의. 기존 상담 폼과 같은 방식이다.
  privacyAgreed Boolean @default(false)

  /// 신청서를 작성한 사이트 언어. "ko" 또는 "en"
  locale String @default("ko")

  /// 관리자만 보는 내부 기록. 별도 audit 표를 만들지 않고 이 칸 하나로 둔다. (지시 26항)
  adminMemo String?

  submittedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  educations AdmissionEducation[]
  careers    AdmissionCareer[]
  files      AdmissionFile[]

  /// 관리자 목록의 상태 필터 + 최신순 정렬용
  @@index([status, submittedAt])
  @@index([program, status])
  @@map("admission_applications")
}

/// 학력 한 줄. 원본 입학원서의 학력표 칸(학교명 / 학교 주소 / 재학기간 / 학위명)을 그대로 옮겼다.
/// **전공 칸은 원본에 없으므로 만들지 않는다.** (지시 9항)
///
/// `period` 를 날짜 두 개가 아니라 문자열로 두는 이유: 원본이 "재학기간" 한 칸이고
/// 지원자가 "2015.03 ~ 2019.02" 처럼 자유롭게 적는다. 날짜로 쪼개면 정확한 일자를
/// 모르는 지원자가 입력할 수 없고, 홈페이지는 이 값을 정렬·집계하지 않는다.
model AdmissionEducation {
  id            String               @id @default(cuid())
  applicationId String
  application   AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  schoolName    String
  schoolAddress String?
  period        String?
  degreeName    String?
  sortOrder     Int     @default(0)

  createdAt DateTime @default(now())

  @@index([applicationId, sortOrder])
  @@map("admission_educations")
}

/// 경력 한 줄. 원본 입학원서의 경력표 칸(직장명 / 기간 / 직위).
/// **주요업무·설명 칸은 원본에 없으므로 만들지 않는다.** (지시 10항)
model AdmissionCareer {
  id            String               @id @default(cuid())
  applicationId String
  application   AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  organization String
  period       String?
  position     String?
  sortOrder    Int     @default(0)

  createdAt DateTime @default(now())

  @@index([applicationId, sortOrder])
  @@map("admission_careers")
}

/// 입학신청에 딸린 파일.
///
/// ⚠️ **`Media` 와 절대 섞지 않는다.**
/// `Media.path` 는 **공개 URL**(`/media/<uuid>.jpg`)이고 그 라우트에는 인증이 없다.
/// 여기 `path` 는 **비공개 저장소의 상대 경로**(`<applicationId>/<uuid>.jpg`)이며
/// 공개 라우트가 존재하지 않는다. 관리자 로그인 뒤 전용 다운로드 라우트로만 나간다.
model AdmissionFile {
  id            String               @id @default(cuid())
  applicationId String
  application   AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  type AdmissionFileType

  /// 지원자가 올린 원본 파일명. **표시·다운로드 파일명으로만 쓰고 저장 경로에는 쓰지 않는다.**
  originalName String
  /// 실제 저장 파일명. `<uuid>.<확장자>` 이며 확장자는 magic byte 판정 결과에서 나온다.
  storedName   String @unique
  mimeType     String
  size         Int
  /// 업로드 루트 기준 상대 경로. 공개 URL 이 아니다.
  path         String

  createdAt DateTime @default(now())

  @@index([applicationId, type])
  @@map("admission_files")
}
