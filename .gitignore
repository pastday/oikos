# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*

# testing
/coverage

# next.js
.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.*.local
# .env.example 은 템플릿이므로 반드시 커밋한다 (CLAUDE.md 19항)
!.env.example

# 업로드 파일 (실제 파일은 커밋하지 않고 디렉터리 구조만 유지)
public/uploads/*
!public/uploads/.gitkeep

# 원본 근거자료
# 민감정보/저작권 자료가 포함될 수 있어 현재는 Git에 포함하지 않는다.
# (포함 여부는 추후 결정 — 결정 시 아래 4줄을 수정한다)
docs/source/*
!docs/source/.gitkeep
assets/source/*
!assets/source/.gitkeep

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
