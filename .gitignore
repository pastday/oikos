# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*

# testing
/coverage

# next.js
.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.*.local
# .env.example 은 템플릿이므로 반드시 커밋한다 (CLAUDE.md 19항)
!.env.example

# 업로드 파일
# 11단계부터 실제 저장 위치는 저장소 **바깥**이다. (../oikos-data/uploads)
# git 작업이나 배포 디렉터리 교체로 운영 데이터가 사라지지 않게 하기 위해서다.
# 아래 규칙은 예전 경로에 남은 파일이 실수로 커밋되는 것을 막기 위해 그대로 둔다.
public/uploads/*
!public/uploads/.gitkeep

# 원본 근거자료
# 민감정보/저작권 자료가 포함될 수 있어 현재는 Git에 포함하지 않는다.
# (포함 여부는 추후 결정 — 결정 시 아래 4줄을 수정한다)
docs/source/*
!docs/source/.gitkeep
assets/source/*
!assets/source/.gitkeep

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
