# oikos.pastday.co.kr — Oikos University 경영대학원 홈페이지 (Next.js)
#
# 설치:
#   sudo cp /home/pastday/oikos/deploy/systemd/oikos.service /etc/systemd/system/oikos.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now oikos
#
# 상태 확인:
#   systemctl status oikos
#   journalctl -u oikos -n 50 --no-pager
#
# 코드 갱신 후 재시작:
#   cd /home/pastday/oikos && npm ci && npm run build && sudo systemctl restart oikos
#
# 업로드 디렉터리 준비 (최초 1회):
#   mkdir -p /home/pastday/oikos-data/uploads
#   chmod 755 /home/pastday/oikos-data /home/pastday/oikos-data/uploads
#   (소유자는 아래 User/Group 과 같아야 한다)

[Unit]
Description=oikos.pastday.co.kr - Oikos University Graduate School site (Next.js)
After=network.target

[Service]
Type=simple
User=pastday
Group=pastday
WorkingDirectory=/home/pastday/oikos

Environment=NODE_ENV=production
# 외부에 직접 노출하지 않고 nginx 를 통해서만 접근한다.
ExecStart=/usr/bin/node /home/pastday/oikos/node_modules/next/dist/bin/next start -p 3100 -H 127.0.0.1

Restart=on-failure
RestartSec=3

# 최소 권한
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
# ProtectHome=read-only 때문에 /home 전체가 읽기 전용이다.
# 서비스가 써야 하는 경로만 여기에 다시 열어 준다.
#   .next          Next.js 런타임 캐시 (이미지 최적화 등)
#   oikos-data     관리자 업로드 파일 (11단계)
#
# ⚠️ 업로드 디렉터리를 빠뜨리면 관리자 파일 업로드가 EROFS/EACCES 로 실패한다.
#    업로드 파일을 소스 트리 밖에 둔 이유는 git 작업이나 배포 디렉터리 교체로
#    운영 데이터가 사라지지 않게 하기 위해서다.
ReadWritePaths=/home/pastday/oikos/.next
ReadWritePaths=/home/pastday/oikos-data/uploads

[Install]
WantedBy=multi-user.target
